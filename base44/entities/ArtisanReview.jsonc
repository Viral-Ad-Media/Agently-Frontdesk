
{
  "name": "ArtisanReview",
  "type": "object",
  "properties": {
    "artisan_id": {
      "type": "string",
      "description": "Slug of the artisan being reviewed"
    },
    "artisan_name": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": "string"
    },
    "worked_with": {
      "type": "boolean",
      "description": "Customer confirms they hired this artisan",
      "default": true
    }
  },
  "required": [
    "artisan_id",
    "artisan_name",
    "customer_name",
    "rating",
    "comment"
  ]
}