
{
  "name": "BookingRequest",
  "type": "object",
  "properties": {
    "artisan_id": {
      "type": "string",
      "description": "Slug of the artisan"
    },
    "artisan_name": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "preferred_date": {
      "type": "string",
      "description": "Preferred visit date"
    },
    "notes": {
      "type": "string",
      "description": "Description of the job"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted"
      ],
      "default": "pending"
    },
    "assigned_artisan_id": {
      "type": "string"
    },
    "assigned_artisan_name": {
      "type": "string"
    },
    "assigned_date": {
      "type": "string",
      "description": "Date the job was accepted"
    }
  },
  "required": [
    "artisan_id",
    "customer_name",
    "phone"
  ]
}