# Copy to .env.local and fill in. Never commit real keys.

# Which AI provider the app uses: mock (no keys, deterministic rehearsal) | meta
VITE_AI_PROVIDER=mock

# Server side only (read by the /api proxy, never shipped to the browser)
META_API_KEY=
# MODEL_API_KEY=            # accepted instead of META_API_KEY

# Optional: model ids per task and per router tier. Leave empty to use the provider defaults.
VITE_META_SPARK_MODEL=
VITE_META_SPARK_LIGHT_MODEL=
VITE_META_TIER_SMALL_MODEL=
VITE_META_TIER_MEDIUM_MODEL=
VITE_META_TIER_LARGE_MODEL=

# Optional: prices in USD per million tokens. Cost is shown only when both are set, never estimated.
VITE_META_PRICE_IN_PER_M=
VITE_META_PRICE_OUT_PER_M=
